{
  "expo": {
    "name": "Knowledge_King",
    "slug": "Knowledge_King",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "locales": {
      "zh-TW": "./locales/zh-TW.json",
      "en": "./locales/en.json"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.justin.knowledgeking",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.justin.knowledgeking",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E3A8A"
      }
    },
    "web": {},
    "plugins": [
      "react-native-nitro-google-signin",
      "expo-localization",
      "expo-font",
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "61705626-0364-423f-b0f7-3ab13d29dca6"
      }
    }
  }
}
